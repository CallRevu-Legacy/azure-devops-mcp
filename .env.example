# Remote Server Configuration
# Copy this file to .env and update with your values

# Azure Storage Connection String for storing encrypted PATs
# Get this from Azure Portal: Storage Account > Access keys
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=youraccountname;AccountKey=youraccountkey;EndpointSuffix=core.windows.net

# Encryption key for PAT storage (64 hex characters, 32 bytes)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# IMPORTANT: Store this securely in Azure Key Vault in production
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Comma-separated list of allowed CORS origins
# Leave empty to allow all origins (not recommended for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,https://yourdomain.com

# Azure DevOps organization name
# This can also be passed as a command line argument
ORGANIZATION=your-org-name
